# AssetChain — copy to .env. ALL VALUES ARE TEST-ONLY. Never use real keys or real funds.
POSTGRES_USER=assetchain
POSTGRES_PASSWORD=assetchain
POSTGRES_DB=assetchain

# Local EVM node (Hardhat). Phase 2 can point this to Hyperledger Besu.
RPC_URL=http://chain:8545
CHAIN_ID=31337
GAS_PRICE_MODE=auto

# Hardhat's public account #0 — the platform treasury/deployer. Worthless on any real network.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Master key that encrypts wallet keys at rest (Fernet). Generate your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=0uS1lgnfu7t4CB-5Vho-SnN3L2AJmYSnWghlR5TkbmU=

# Set to true to also approve/deploy ASSET-001 and make a 100k transfer at startup.
SEED_DEMO=false
LOG_LEVEL=INFO
